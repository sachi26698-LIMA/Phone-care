# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------------------
# Optional: enhanced AI assistant (server-side only).
# Leave these unset to run the deterministic local reasoning engine.
# NEVER prefix these with NEXT_PUBLIC_ — that would ship the key to the browser.
# ---------------------------------------------------------------------------
# ASSISTANT_API_URL=https://api.openai.com/v1/chat/completions
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=gpt-4o-mini
